{
  "name": "worship-pads-monorepo",
  "private": true,
  "version": "1.0.0",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "install:backend": "npm --prefix noraa_parfums/backend install",
    "install:frontend": "npm --prefix worship-pads install",
    "postinstall": "npm run install:backend",
    "build": "npm run install:frontend && npm --prefix worship-pads run build",
    "start": "npm --prefix noraa_parfums/backend start",
    "dev:frontend": "npm --prefix worship-pads run dev",
    "dev:backend": "npm --prefix noraa_parfums/backend run dev"
  }
}
